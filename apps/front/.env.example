# URL del API de señalización NestJS.
VITE_API_URL=http://localhost:3000

# --- Auth0 (SPA) ---
# Estos valores son PÚBLICOS: viajan en el bundle del navegador. No hay ningún
# secreto acá, y está bien: el flujo SPA usa PKCE, que no necesita client secret.
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=tu-client-id-de-la-app-SPA
# Debe coincidir EXACTO con el AUTH0_AUDIENCE del /api. Si no coincide, Auth0
# emite un token opaco y el backend responde 401.
VITE_AUTH0_AUDIENCE=https://api.my-turborepo
