# Puerto HTTP de esta instancia del API (corré 2 con puertos distintos para probar Pub/Sub).
PORT=3000

# Origen del front (Vite) para CORS en dev.
CORS_ORIGIN=http://localhost:3001

# Redis de Upstash. DEBE usar esquema rediss:// (TLS). NO uses el SDK REST @upstash/redis.
# Formato: rediss://default:PASSWORD@HOST:6379
REDIS_URL=rediss://default:PASSWORD@your-host.upstash.io:6379

# Postgres (Neon). Requiere TLS: dejá el sslmode=require de la connection string.
# Formato: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://user:password@your-host.neon.tech/neondb?sslmode=require

# --- Auth0 ---
# Dominio del tenant, sin https://
AUTH0_DOMAIN=tu-tenant.us.auth0.com
# Identifier de la API creada en Auth0 (NO es una URL a la que se llame).
# Debe coincidir EXACTO con el VITE_AUTH0_AUDIENCE del front.
AUTH0_AUDIENCE=https://api.my-turborepo
# Issuer, CON la barra final.
AUTH0_ISSUER_URL=https://tu-tenant.us.auth0.com/

# Ojo: acá NO va ningún client secret. El API valida las firmas contra el JWKS
# publico de Auth0 (/.well-known/jwks.json), así que no guarda secretos suyos.

# --- Prueba de carga (opcional, solo dev) ---
# Si se define, el JwtAuthGuard acepta el header `x-load-test` con este valor y
# saltea la validación de Auth0, usando el `sub` de `x-load-test-sub`.
# Queda DESACTIVADO automáticamente si NODE_ENV=production. Dejar vacío o sin
# definir en cualquier entorno real.
LOAD_TEST_SECRET=
